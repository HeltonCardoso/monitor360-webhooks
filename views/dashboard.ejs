<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MONITOR360</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
  <style>
    /* ── TEMA ESCURO (padrão) ── */
    :root {
      --bg: #0a0e17;
      --surface: #111827;
      --surface2: #1a2332;
      --border: #1e2d40;
      --accent: #00d4ff;
      --accent2: #ff6b35;
      --success: #00e676;
      --warning: #ffab00;
      --danger: #ff1744;
      --text: #e2e8f0;
      --text-muted: #64748b;
      --font-mono: 'JetBrains Mono', monospace;
      --font-display: 'Syne', sans-serif;
    }

    /* ── TEMA CLARO ── */
    html.light {
      --bg: #f0f4f8;
      --surface: #ffffff;
      --surface2: #e8eef5;
      --border: #c8d6e5;
      --accent: #0099bb;
      --accent2: #e05520;
      --success: #00a854;
      --warning: #d48000;
      --danger: #d01030;
      --text: #1a2332;
      --text-muted: #637282;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 13px;
      min-height: 100vh;
      transition: background .25s, color .25s;
    }

    /* ── TOPBAR ── */
    .topbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      height: 52px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 20px;
      transition: background .25s, border-color .25s;
    }
    .topbar-brand {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      color: var(--accent);
      letter-spacing: 2px;
      display: flex; align-items: center; gap: 10px;
    }
    .topbar-brand .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 8px var(--success);
      animation: pulse 2s infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

    .topbar-right { display: flex; align-items: center; gap: 12px; }
    .topbar-time { color: var(--text-muted); font-size: 12px; }
    .btn-refresh {
      background: var(--surface2); border: 1px solid var(--border);
      color: var(--accent); padding: 6px 14px; border-radius: 4px;
      cursor: pointer; font-family: var(--font-mono); font-size: 12px;
      transition: all .2s;
    }
    .btn-refresh:hover { background: var(--accent); color: var(--bg); }

    /* ── BOTÃO DE TEMA ── */
    .btn-theme {
      background: var(--surface2);
      border: 1px solid var(--border);
      color: var(--text-muted);
      width: 34px; height: 34px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 15px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: all .2s;
    }
    .btn-theme:hover { border-color: var(--accent); color: var(--accent); }

    /* ── SIDEBAR ── */
    .sidebar {
      position: fixed; left: 0; top: 52px; bottom: 0;
      width: 200px;
      background: var(--surface);
      border-right: 1px solid var(--border);
      padding: 20px 0;
      display: flex; flex-direction: column;
      transition: background .25s, border-color .25s;
    }
    .nav-item-s {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 20px;
      color: var(--text-muted);
      text-decoration: none;
      border-left: 2px solid transparent;
      transition: all .2s;
      font-size: 12px;
    }
    .nav-item-s:hover, .nav-item-s.active {
      color: var(--accent);
      border-left-color: var(--accent);
      background: rgba(0,180,220,.06);
    }
    .nav-item-s i { width: 18px; text-align: center; }
    .nav-divider { border-color: var(--border); margin: 12px 20px; }

    /* ── MAIN ── */
    .main {
      margin-left: 200px;
      margin-top: 52px;
      padding: 24px;
      min-height: calc(100vh - 52px);
    }

    .page-title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 22px;
      color: var(--text);
      margin-bottom: 20px;
      display: flex; align-items: center; gap: 12px;
    }
    .page-title span { color: var(--accent); }

    /* ── GRID ── */
    .grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 16px; }
    .grid-2 { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-bottom: 16px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; margin-bottom: 16px; }

    /* ── CARDS ── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      transition: background .25s, border-color .25s;
    }
    .card-header {
      padding: 10px 16px;
      border-bottom: 1px solid var(--border);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--text-muted);
      display: flex; align-items: center; gap: 8px;
    }
    .card-header i { color: var(--accent); }
    .card-body { padding: 16px; }

    /* ── METRIC CARDS ── */
    .metric {
      padding: 18px 16px;
      position: relative;
      overflow: hidden;
    }
    .metric::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 2px;
    }
    .metric.blue::before { background: var(--accent); }
    .metric.orange::before { background: var(--accent2); }
    .metric.green::before { background: var(--success); }
    .metric.red::before { background: var(--danger); }
    .metric.yellow::before { background: var(--warning); }

    .metric-val {
      font-family: var(--font-display);
      font-size: 36px;
      font-weight: 800;
      line-height: 1;
      margin-bottom: 4px;
    }
    .metric.blue .metric-val { color: var(--accent); }
    .metric.orange .metric-val { color: var(--accent2); }
    .metric.green .metric-val { color: var(--success); }
    .metric.red .metric-val { color: var(--danger); }
    .metric.yellow .metric-val { color: var(--warning); }

    .metric-label { color: var(--text-muted); font-size: 11px; letter-spacing: .5px; }
    .metric-sub { font-size: 11px; color: var(--text-muted); margin-top: 6px; }

    /* ── PIPELINE ── */
    .pipeline-flow {
      display: flex; align-items: center; gap: 0;
      padding: 20px 16px;
    }
    .pipeline-stage {
      flex: 1;
      text-align: center;
      position: relative;
    }
    .pipeline-stage::after {
      content: '→';
      position: absolute; right: -8px; top: 50%; transform: translateY(-50%);
      color: var(--border); font-size: 16px;
    }
    .pipeline-stage:last-child::after { display: none; }

    .stage-bubble {
      width: 52px; height: 52px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 8px;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 16px;
      border: 2px solid var(--border);
      transition: all .3s;
    }
    .stage-bubble.active {
      border-color: var(--accent);
      background: rgba(0,180,220,.1);
      color: var(--accent);
      box-shadow: 0 0 16px rgba(0,180,220,.2);
    }
    .stage-bubble.warning {
      border-color: var(--warning);
      background: rgba(200,130,0,.1);
      color: var(--warning);
    }
    .stage-name { font-size: 10px; color: var(--text-muted); letter-spacing: .5px; }
    .stage-count { font-size: 18px; font-weight: 700; color: var(--text); }

    /* ── TAXA SYNC ── */
    .sync-bar-wrap { background: var(--surface2); border-radius: 3px; height: 8px; overflow: hidden; margin: 10px 0 6px; }
    .sync-bar { height: 100%; background: linear-gradient(90deg, var(--accent), var(--success)); border-radius: 3px; transition: width 1s; }

    /* ── TABLE ── */
    .tbl { width: 100%; border-collapse: collapse; }
    .tbl th {
      padding: 8px 12px;
      text-align: left;
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border);
    }
    .tbl td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }
    .tbl tr:hover td { background: rgba(0,180,220,.04); }
    .tbl tr:last-child td { border-bottom: none; }

    /* ── BADGES ── */
    .badge-tipo {
      display: inline-block;
      padding: 3px 8px; border-radius: 3px;
      font-size: 10px; font-weight: 600; letter-spacing: .5px;
      font-family: var(--font-mono);
    }
    .badge-NAO_INTEGROU_JET { background: rgba(255,23,68,.15); color: #ff6b8a; border: 1px solid rgba(255,23,68,.3); }
    .badge-FATURADO_APOS_ENVIO { background: rgba(255,171,0,.15); color: var(--warning); border: 1px solid rgba(255,171,0,.3); }
    .badge-TRAVADO { background: rgba(255,107,53,.15); color: var(--accent2); border: 1px solid rgba(255,107,53,.3); }
    .badge-default { background: rgba(100,116,139,.15); color: var(--text-muted); border: 1px solid rgba(100,116,139,.3); }

    .badge-mkt {
      display: inline-block; padding: 2px 8px; border-radius: 3px;
      font-size: 10px; font-weight: 600;
    }
    .badge-SHOPEE { background: rgba(238,77,45,.15); color: #e05000; }
    .badge-MERCADO_LIVRE { background: rgba(200,160,0,.15); color: #c09000; }
    .badge-MAGAZINE_LUIZA { background: rgba(0,100,220,.15); color: #0070cc; }
    html:not(.light) .badge-SHOPEE { color: #ff7043; }
    html:not(.light) .badge-MERCADO_LIVRE { color: #ffd600; }
    html:not(.light) .badge-MAGAZINE_LUIZA { color: #64b5f6; }
    .badge-default-mkt { background: rgba(100,116,139,.15); color: var(--text-muted); }

    .btn-resolver {
      background: none; border: 1px solid var(--success);
      color: var(--success); padding: 3px 10px; border-radius: 3px;
      cursor: pointer; font-size: 11px; font-family: var(--font-mono);
      transition: all .2s;
    }
    .btn-resolver:hover { background: var(--success); color: var(--bg); }

    /* ── CHARTS ── */
    .chart-wrap { position: relative; height: 200px; }

    /* ── MARKETPLACE LIST ── */
    .mkt-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid var(--border);
    }
    .mkt-item:last-child { border-bottom: none; }
    .mkt-bar-bg { flex: 1; margin: 0 12px; background: var(--surface2); border-radius: 2px; height: 4px; }
    .mkt-bar { height: 100%; border-radius: 2px; background: var(--accent); }

    /* ── EMPTY ── */
    .empty-state { text-align: center; padding: 30px; color: var(--text-muted); }
    .empty-state i { font-size: 28px; margin-bottom: 8px; display: block; opacity: .3; }

    /* ── LOADING ── */
    .loading { color: var(--text-muted); font-size: 12px; padding: 20px; text-align: center; }

    /* ── ALERT TOAST ── */
    .toast-container {
      position: fixed; top: 64px; right: 16px; z-index: 200;
      display: flex; flex-direction: column; gap: 8px;
    }
    .toast-item {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 4px; padding: 10px 16px;
      font-size: 12px; min-width: 280px;
      display: flex; align-items: center; gap: 10px;
      animation: slideIn .3s ease;
    }
    @keyframes slideIn { from{transform:translateX(100%);opacity:0} to{transform:translateX(0);opacity:1} }
    .toast-item.success { border-color: var(--success); }
    .toast-item.danger { border-color: var(--danger); }

    /* ── TOOLTIPS EXPLICATIVOS ── */
    .help-tip {
      display: inline-block;
      width: 16px; height: 16px;
      background: var(--surface2);
      border-radius: 50%;
      text-align: center;
      line-height: 16px;
      font-size: 10px; font-weight: bold;
      color: var(--text-muted);
      cursor: help;
      margin-left: 6px;
      position: relative;
    }
    .help-tip:hover::after {
      content: attr(data-tip);
      position: absolute;
      bottom: 100%; left: 50%;
      transform: translateX(-50%);
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 6px 10px; border-radius: 4px;
      font-size: 10px; white-space: nowrap;
      z-index: 1000;
      color: var(--accent);
      font-family: var(--font-mono);
    }

    @media(max-width:768px) {
      .sidebar { display: none; }
      .main { margin-left: 0; padding: 16px; }
      .grid-4 { grid-template-columns: repeat(2,1fr); }
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="topbar-brand">
    <div class="dot"></div>
    MONITOR360
  </div>
  <div class="topbar-right">
    <span class="topbar-time" id="clock">--:--:--</span>
    <button class="btn-theme" id="btn-theme" title="Alternar tema">🌙</button>
    <button class="btn-refresh" onclick="refreshAll()">
      <i class="fas fa-sync-alt"></i> Atualizar
    </button>
  </div>
</div>

<!-- TOAST -->
<div class="toast-container" id="toasts"></div>

<!-- SIDEBAR -->
<div class="sidebar">
  <a href="/" class="nav-item-s active"><i class="fas fa-th-large"></i> Dashboard</a>
  <a href="/pedidos" class="nav-item-s"><i class="fas fa-boxes"></i> Pedidos</a>
  <a href="/anomalias" class="nav-item-s"><i class="fas fa-exclamation-triangle"></i> Anomalias</a>
  <a href="/upload" class="nav-item-s"><i class="fas fa-file-upload"></i> Comparar Planilha</a>
  <hr class="nav-divider">
  <a href="#" class="nav-item-s" onclick="alert('Em desenvolvimento')"><i class="fas fa-cog"></i> Config</a>
</div>

<!-- MAIN -->
<div class="main">

  <div class="page-title">
    <i class="fas fa-th-large" style="color:var(--accent);font-size:18px"></i>
    DASH<span>BOARD</span>
  </div>

  <!-- MÉTRICAS TOPO -->
  <div class="grid-4">
    <div class="card metric blue">
      <div class="metric-val" id="m-anymarket">—</div>
      <div class="metric-label">
        PEDIDOS ANYMARKET
        <span class="help-tip" data-tip="Pedidos que chegaram do marketplace via webhook">?</span>
      </div>
      <div class="metric-sub" id="m-24h">— nas últimas 24h</div>
    </div>
    <div class="card metric orange">
      <div class="metric-val" id="m-jet">—</div>
      <div class="metric-label">
        INTEGRADOS JET
        <span class="help-tip" data-tip="Pedidos que chegaram no ERP (seu sistema interno)">?</span>
      </div>
      <div class="metric-sub" id="m-taxa">taxa de sync: —%</div>
    </div>
    <div class="card metric yellow">
      <div class="metric-val" id="m-travados">—</div>
      <div class="metric-label">
        PEDIDOS TRAVADOS
        <span class="help-tip" data-tip="Pedidos sem atualização há mais de 1 hora - precisam de atenção">?</span>
      </div>
      <div class="metric-sub">sem update há +1h</div>
    </div>
    <div class="card metric red">
      <div class="metric-val" id="m-anomalias">—</div>
      <div class="metric-label">
        ANOMALIAS ABERTAS
        <span class="help-tip" data-tip="Problemas não resolvidos no fluxo dos pedidos">?</span>
      </div>
      <div class="metric-sub">não resolvidas</div>
    </div>
  </div>

  <!-- PIPELINE FLOW -->
  <div class="card" style="margin-bottom:16px">
    <div class="card-header">
      <i class="fas fa-route"></i> FLUXO DO PIPELINE
      <span class="help-tip" data-tip="Caminho que o pedido percorre: Marketplace → ERP → Produção → Confirmação de Envio">?</span>
    </div>
    <div class="pipeline-flow" id="pipeline-flow">
      <div class="loading">Carregando pipeline...</div>
    </div>
  </div>

  <!-- LINHA 2: SYNC + MARKETPLACE -->
  <div class="grid-2">
    <div class="card">
      <div class="card-header">
        <i class="fas fa-sync"></i> SINCRONIZAÇÃO JET
        <span class="help-tip" data-tip="Percentual de pedidos que chegaram no ERP corretamente">?</span>
      </div>
      <div class="card-body">
        <div style="display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-size:11px;color:var(--text-muted)">Pedidos integrados / Total recebidos</span>
          <span id="taxa-pct" style="font-size:24px;font-weight:700;color:var(--accent)">—%</span>
        </div>
        <div class="sync-bar-wrap"><div class="sync-bar" id="taxa-bar" style="width:0%"></div></div>
        <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text-muted);margin-top:4px">
          <span id="sync-jet">JET: —</span>
          <span id="sync-any">AnyMarket: —</span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <i class="fas fa-store"></i> POR MARKETPLACE
        <span class="help-tip" data-tip="Volume de pedidos por marketplace (apenas ativos, não finalizados)">?</span>
      </div>
      <div class="card-body" id="marketplace-list">
        <div class="loading">Carregando...</div>
      </div>
    </div>
  </div>

  <!-- LINHA 3: GRÁFICOS -->
  <div class="grid-2">
    <div class="card">
      <div class="card-header">
        <i class="fas fa-chart-bar"></i> STATUS POR PLATAFORMA
        <span class="help-tip" data-tip="Distribuição dos status dos pedidos em cada sistema">?</span>
      </div>
      <div class="card-body">
        <div class="chart-wrap"><canvas id="chartStatus"></canvas></div>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <i class="fas fa-chart-line"></i> VOLUME ÚLTIMAS 24H
        <span class="help-tip" data-tip="Quantidade de pedidos recebidos por hora nas últimas 24h">?</span>
      </div>
      <div class="card-body">
        <div class="chart-wrap"><canvas id="chartVolume"></canvas></div>
      </div>
    </div>
  </div>

  <!-- ANOMALIAS -->
  <div class="card">
    <div class="card-header" style="justify-content:space-between">
      <span>
        <i class="fas fa-exclamation-triangle"></i> ANOMALIAS RECENTES
        <span class="help-tip" data-tip="Problemas detectados no fluxo que precisam ser resolvidos">?</span>
      </span>
      <a href="/anomalias" style="color:var(--accent);font-size:11px;text-decoration:none">ver todas →</a>
    </div>
    <div class="card-body" style="padding:0">
      <table class="tbl" id="tbl-anomalias">
        <thead>
          <tr>
            <th>Pedido</th>
            <th>Tipo</th>
            <th>Descrição</th>
            <th>Marketplace</th>
            <th>Data</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody><tr><td colspan="6" class="loading">Carregando...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- LEGENDA EXPLICATIVA -->
  <div class="card mt-4" style="margin-top: 20px;">
    <div class="card-header">
      <i class="fas fa-info-circle"></i> ENTENDENDO O DASHBOARD
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <strong style="color: var(--accent)">📦 Pedidos AnyMarket</strong>
          <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Total de pedidos recebidos dos marketplaces via webhook</p>
        </div>
        <div class="col-md-3">
          <strong style="color: var(--accent2)">🔄 Integrados JET</strong>
          <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Pedidos que chegaram no ERP (sistema interno)</p>
        </div>
        <div class="col-md-3">
          <strong style="color: var(--warning)">⚠️ Pedidos Travados</strong>
          <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Sem atualização há +1 hora - precisam de atenção</p>
        </div>
        <div class="col-md-3">
          <strong style="color: var(--danger)">🚨 Anomalias Abertas</strong>
          <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Problemas não resolvidos no fluxo dos pedidos</p>
        </div>
      </div>
      <hr style="border-color: var(--border); margin: 12px 0;">
      <div class="row">
        <div class="col-md-4">
          <strong>📊 Pipeline (Fluxo do Pedido)</strong>
          <p style="font-size: 11px; color: var(--text-muted);">ANYMARKET → JET → ONCLICK → RETORNO_JET → RETORNO_ANYMARKET</p>
          <p style="font-size: 10px; color: var(--text-muted);">1. Pedido chega | 2. Integra no ERP | 3. Entra em produção | 4. Confirma envio | 5. Atualiza marketplace</p>
        </div>
        <div class="col-md-4">
          <strong>✅ Taxa de Sincronização</strong>
          <p style="font-size: 11px; color: var(--text-muted);">Percentual de pedidos que chegaram no ERP corretamente</p>
          <p style="font-size: 10px; color: var(--text-muted);">Quanto maior, melhor a integração entre os sistemas</p>
        </div>
        <div class="col-md-4">
          <strong>🎯 Comparar Planilha</strong>
          <p style="font-size: 11px; color: var(--text-muted);">Envie planilhas dos marketplaces para ver o que não integrou</p>
          <p style="font-size: 10px; color: var(--text-muted);">Use no menu lateral "Comparar Planilha"</p>
        </div>
      </div>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
let chartStatus = null;
let chartVolume = null;

// ── TEMA (VERSÃO ÚNICA E CORRIGIDA) ──
window.getTheme = function() { 
  return localStorage.getItem('m360-theme') || 'dark'; 
};

window.applyTheme = function(t) {
  if (t === 'light') {
    document.documentElement.classList.add('light');
  } else {
    document.documentElement.classList.remove('light');
  }
  // Atualizar texto do botão se ele já existir
  const btn = document.getElementById('btn-theme');
  if (btn) {
    btn.textContent = t === 'dark' ? '🌙' : '☀️';
    btn.title = t === 'dark' ? 'Alternar para tema claro' : 'Alternar para tema escuro';
  }
};

window.toggleTheme = function() {
  const next = window.getTheme() === 'dark' ? 'light' : 'dark';
  localStorage.setItem('m360-theme', next);
  window.applyTheme(next);
  if (typeof window.carregarGraficos === 'function') {
    window.carregarGraficos();
  }
};

// Aplica tema salvo ao carregar
window.applyTheme(window.getTheme());

// Event listener para o botão (sem onclick inline)
document.addEventListener('DOMContentLoaded', function() {
  const themeBtn = document.getElementById('btn-theme');
  if (themeBtn) {
    themeBtn.addEventListener('click', window.toggleTheme);
  }
});

// ── CLOCK ──
function updateClock() {
  document.getElementById('clock').textContent = new Date().toLocaleTimeString('pt-BR');
}
updateClock();
setInterval(updateClock, 1000);

// ── TOAST ──
function toast(msg, type = 'success') {
  const el = document.createElement('div');
  el.className = `toast-item ${type}`;
  el.innerHTML = `<i class="fas fa-${type==='success'?'check-circle':'exclamation-circle'}" style="color:var(--${type==='success'?'success':'danger'})"></i> ${msg}`;
  document.getElementById('toasts').appendChild(el);
  setTimeout(() => el.remove(), 4000);
}

// ── CORES DOS CHARTS (adapta ao tema) ──
function chartGridColor() {
  return window.getTheme() === 'light' ? 'rgba(180,200,220,.4)' : 'rgba(30,45,64,.5)';
}
function chartTickColor() {
  return window.getTheme() === 'light' ? '#637282' : '#64748b';
}

// ── MÉTRICAS ──
async function carregarMetricas() {
  try {
    const r = await fetch('/api/metricas');
    const d = await r.json();
    if (!d.success) return;
    const { metricas, anomaliasNaoResolvidas, pedidosTravados, porEstagio, taxaSincronizacaoJet, pedidos24h, porMarketplace } = d.data;

    document.getElementById('m-anymarket').textContent = metricas.ANYMARKET ?? '—';
    document.getElementById('m-jet').textContent = metricas.JET ?? '—';
    document.getElementById('m-travados').textContent = pedidosTravados ?? '—';
    document.getElementById('m-anomalias').textContent = anomaliasNaoResolvidas ?? '—';
    document.getElementById('m-24h').textContent = `${pedidos24h ?? 0} nas últimas 24h`;
    document.getElementById('m-taxa').textContent = `taxa de sync: ${taxaSincronizacaoJet ?? 0}%`;

    const taxa = taxaSincronizacaoJet ?? 0;
    document.getElementById('taxa-pct').textContent = taxa + '%';
    document.getElementById('taxa-bar').style.width = taxa + '%';
    document.getElementById('sync-jet').textContent = `JET: ${metricas.JET ?? 0}`;
    document.getElementById('sync-any').textContent = `AnyMarket: ${metricas.ANYMARKET ?? 0}`;

    renderPipeline(porEstagio);
    renderMarketplace(porMarketplace);

  } catch(e) { console.error(e); }
}

// ── PIPELINE ──
function renderPipeline(porEstagio) {
  const stages = [
    { key: 'ANYMARKET',         label: 'ANYMARKET',  icon: 'A' },
    { key: 'JET',               label: 'JET',         icon: 'J' },
    { key: 'ONCLICK',           label: 'ONCLICK',     icon: 'O' },
    { key: 'RETORNO_JET',       label: 'RET.JET',     icon: 'RJ' },
    { key: 'RETORNO_ANYMARKET', label: 'RET.ANY',     icon: 'RA' },
  ];
  const max = Math.max(...stages.map(s => porEstagio[s.key] || 0), 1);
  const el = document.getElementById('pipeline-flow');
  el.innerHTML = stages.map(s => {
    const count = porEstagio[s.key] || 0;
    const pct = count / max;
    const cls = count > 0 ? (pct < 0.5 ? 'warning' : 'active') : '';
    return `
      <div class="pipeline-stage">
        <div class="stage-bubble ${cls}">${s.icon}</div>
        <div class="stage-count">${count}</div>
        <div class="stage-name">${s.label}</div>
      </div>`;
  }).join('');
}

// ── MARKETPLACE ──
function renderMarketplace(list) {
  const el = document.getElementById('marketplace-list');
  if (!list || !list.length) {
    el.innerHTML = '<div class="empty-state"><i class="fas fa-store"></i>Sem dados</div>';
    return;
  }
  const max = Math.max(...list.map(m => parseInt(m.total)), 1);
  const mktColors = {
    SHOPEE: 'var(--accent2)',
    MERCADO_LIVRE: window.getTheme()==='light'?'#c09000':'#ffd600',
    MAGAZINE_LUIZA: window.getTheme()==='light'?'#0070cc':'#64b5f6'
  };
  el.innerHTML = list.map(m => {
    const pct = (parseInt(m.total) / max * 100).toFixed(0);
    const color = mktColors[m.marketplace] || 'var(--accent)';
    const badgeCls = 'badge-' + (m.marketplace || 'default-mkt');
    return `
      <div class="mkt-item">
        <span class="badge-mkt ${badgeCls}">${m.marketplace || 'N/A'}</span>
        <div class="mkt-bar-bg"><div class="mkt-bar" style="width:${pct}%;background:${color}"></div></div>
        <span style="font-size:12px;font-weight:700;min-width:30px;text-align:right">${m.total}</span>
      </div>`;
  }).join('');
}

// ── ANOMALIAS ──
async function carregarAnomalias() {
  try {
    const r = await fetch('/api/anomalias?limit=8&resolvida=false');
    const d = await r.json();
    if (!d.success) return;
    const tbody = document.querySelector('#tbl-anomalias tbody');
    if (!d.anomalias.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty-state"><i class="fas fa-check-circle" style="color:var(--success)"></i>Nenhuma anomalia aberta</td></tr>';
      return;
    }
    tbody.innerHTML = d.anomalias.map(a => {
      const badgeCls = 'badge-' + (a.tipo in {'NAO_INTEGROU_JET':1,'FATURADO_APOS_ENVIO':1,'TRAVADO':1} ? a.tipo : 'default');
      const mktCls = 'badge-' + (a.marketplace || 'default-mkt');
      return `<tr>
        <td style="font-weight:600;color:var(--accent);font-size:11px">${a.pedido_id}</td>
        <td><span class="badge-tipo ${badgeCls}">${a.tipo}</span></td>
        <td style="color:var(--text-muted);font-size:11px;max-width:220px">${a.descricao || '-'}</td>
        <td>${a.marketplace ? `<span class="badge-mkt ${mktCls}">${a.marketplace}</span>` : '-'}</td>
        <td style="color:var(--text-muted);font-size:11px">${new Date(a.criado_em).toLocaleString('pt-BR')}</td>
        <td><button class="btn-resolver" onclick="resolver(${a.id}, this)">Resolver</button></td>
       </tr>`;
    }).join('');
  } catch(e) { console.error(e); }
}

async function resolver(id, btn) {
  btn.disabled = true; btn.textContent = '...';
  try {
    const r = await fetch(`/api/anomalias/${id}/resolver`, { method: 'PATCH' });
    const d = await r.json();
    if (d.success) {
      btn.closest('tr').remove();
      toast('Anomalia marcada como resolvida');
      const el = document.getElementById('m-anomalias');
      el.textContent = Math.max(0, parseInt(el.textContent) - 1);
    }
  } catch(e) { toast('Erro ao resolver', 'danger'); btn.disabled = false; btn.textContent = 'Resolver'; }
}

// ── GRÁFICOS ──
async function carregarGraficos() {
  try {
    const r = await fetch('/api/grafico/status');
    const d = await r.json();
    if (!d.success) return;

    const gc = chartGridColor();
    const tc = chartTickColor();

    const statusData = d.porStatus || {};
    const allStatus = [...new Set([
      ...(statusData.ANYMARKET||[]).map(s=>s.status),
      ...(statusData.JET||[]).map(s=>s.status),
      ...(statusData.ONCLICK||[]).map(s=>s.status)
    ])];

    const ctxStatus = document.getElementById('chartStatus').getContext('2d');
    if (chartStatus) chartStatus.destroy();
    chartStatus = new Chart(ctxStatus, {
      type: 'bar',
      data: {
        labels: allStatus,
        datasets: [
          { label: 'AnyMarket', data: allStatus.map(s => (statusData.ANYMARKET||[]).find(x=>x.status===s)?.total||0), backgroundColor: 'rgba(0,180,220,.7)' },
          { label: 'JET',       data: allStatus.map(s => (statusData.JET||[]).find(x=>x.status===s)?.total||0),       backgroundColor: 'rgba(224,85,32,.7)' },
          { label: 'Onclick',   data: allStatus.map(s => (statusData.ONCLICK||[]).find(x=>x.status===s)?.total||0),   backgroundColor: 'rgba(0,168,84,.7)' }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { color: tc, font: { family: 'JetBrains Mono', size: 11 } } } },
        scales: {
          x: { ticks: { color: tc, font: { size: 10 } }, grid: { color: gc } },
          y: { ticks: { color: tc, font: { size: 10 } }, grid: { color: gc } }
        }
      }
    });

    const vol = d.volumeHoras || [];
    const ctxVol = document.getElementById('chartVolume').getContext('2d');
    if (chartVolume) chartVolume.destroy();
    chartVolume = new Chart(ctxVol, {
      type: 'line',
      data: {
        labels: vol.map(v => new Date(v.hora).toLocaleTimeString('pt-BR', {hour:'2-digit',minute:'2-digit'})),
        datasets: [{
          label: 'Pedidos/hora',
          data: vol.map(v => parseInt(v.total)),
          borderColor: 'var(--accent)',
          backgroundColor: 'rgba(0,180,220,.1)',
          tension: .4, fill: true,
          pointBackgroundColor: 'var(--accent)', pointRadius: 3
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { labels: { color: tc, font: { family: 'JetBrains Mono', size: 11 } } } },
        scales: {
          x: { ticks: { color: tc, font: { size: 10 } }, grid: { color: gc } },
          y: { ticks: { color: tc, font: { size: 10 } }, grid: { color: gc } }
        }
      }
    });
  } catch(e) { console.error(e); }
}

// ── REFRESH ──
function refreshAll() {
  carregarMetricas();
  carregarAnomalias();
  carregarGraficos();
}

refreshAll();
setInterval(refreshAll, 30000);
</script>
</body>
</html>