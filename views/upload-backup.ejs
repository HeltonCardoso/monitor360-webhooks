<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload Planilha - Monitor360</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg: #0a0e17;
      --surface: #111827;
      --border: #1e2d40;
      --accent: #00d4ff;
      --success: #00e676;
      --danger: #ff1744;
      --text: #e2e8f0;
    }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
    }
    .upload-area {
      border: 2px dashed var(--border);
      border-radius: 8px;
      padding: 40px;
      text-align: center;
      transition: all .3s;
      cursor: pointer;
    }
    .upload-area.drag-over {
      border-color: var(--accent);
      background: rgba(0,212,255,.05);
    }
    .result-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-top: 20px;
    }
    .badge-success { background: var(--success); color: #000; }
    .badge-danger { background: var(--danger); }
    .badge-warning { background: #ffab00; color: #000; }
  </style>
</head>
<body>
  <div class="container mt-4">
    <h1><i class="fas fa-file-upload"></i> Comparar Planilha de Vendas</h1>
    <p class="text-muted">Envie uma planilha (Excel/CSV) com seus pedidos para verificar quais foram integrados</p>
    
    <!-- Área de upload -->
    <div class="upload-area" id="uploadArea">
      <i class="fas fa-cloud-upload-alt" style="font-size: 48px; color: var(--accent);"></i>
      <h4 class="mt-3">Arraste ou clique para enviar</h4>
      <p class="text-muted">Suporta .xlsx, .xls, .csv</p>
      <input type="file" id="fileInput" accept=".xlsx,.xls,.csv" style="display: none;">
    </div>
    
    <!-- Loading -->
    <div id="loading" style="display: none;" class="text-center mt-4">
      <i class="fas fa-spinner fa-spin fa-2x"></i>
      <p>Processando planilha...</p>
    </div>
    
    <!-- Resultados -->
    <div id="results" style="display: none;"></div>
  </div>
  
  <script>
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('fileInput');
    const loading = document.getElementById('loading');
    const results = document.getElementById('results');
    
    uploadArea.addEventListener('click', () => fileInput.click());
    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('drag-over');
    });
    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('drag-over');
    });
    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('drag-over');
      const file = e.dataTransfer.files[0];
      if (file) uploadFile(file);
    });
    
    fileInput.addEventListener('change', (e) => {
      if (e.target.files[0]) uploadFile(e.target.files[0]);
    });
    
    async function uploadFile(file) {
      const formData = new FormData();
      formData.append('planilha', file);
      
      loading.style.display = 'block';
      results.style.display = 'none';
      
      try {
        const response = await fetch('/upload/compare', {
          method: 'POST',
          body: formData
        });
        const data = await response.json();
        displayResults(data);
      } catch (error) {
        alert('Erro ao processar: ' + error.message);
      } finally {
        loading.style.display = 'none';
      }
    }
    
    function displayResults(data) {
      if (data.error) {
        results.innerHTML = `<div class="alert alert-danger">${data.error}</div>`;
        results.style.display = 'block';
        return;
      }
      
      const total = data.total_planilha;
      const integrados = data.total_integrados;
      const naoIntegrados = data.nao_integrados.length;
      const taxa = ((integrados / total) * 100).toFixed(1);
      
      results.innerHTML = `
        <div class="result-card p-4">
          <h3>📊 Resultado da Comparação</h3>
          
          <div class="row mt-4">
            <div class="col-md-3">
              <div class="card bg-dark text-white">
                <div class="card-body">
                  <h5>Total Pedidos</h5>
                  <h2>${total}</h2>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card bg-success text-white">
                <div class="card-body">
                  <h5>Integrados</h5>
                  <h2>${integrados}</h2>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card bg-danger text-white">
                <div class="card-body">
                  <h5>Não Integrados</h5>
                  <h2>${naoIntegrados}</h2>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="card bg-info text-dark">
                <div class="card-body">
                  <h5>Taxa de Integração</h5>
                  <h2>${taxa}%</h2>
                </div>
              </div>
            </div>
          </div>
          
          ${naoIntegrados > 0 ? `
            <h5 class="mt-4 text-danger">⚠️ Pedidos NÃO Integrados (${naoIntegrados})</h5>
            <div class="table-responsive">
              <table class="table table-dark table-sm">
                <thead>
                  <tr>
                    <th>ID Pedido</th>
                    <th>Marketplace</th>
                    <th>Status</th>
                    <th>Valor</th>
                    <th>Cliente</th>
                  </tr>
                </thead>
                <tbody>
                  ${data.nao_integrados.slice(0, 20).map(p => `
                    <tr>
                      <td><code>${p.pedido_id}</code></td>
                      <td><span class="badge bg-secondary">${p.marketplace}</span></td>
                      <td>${p.status}</td>
                      <td>R$ ${p.valor_total.toFixed(2)}</td>
                      <td>${p.cliente.substring(0, 30)}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
              ${naoIntegrados > 20 ? `<p class="text-muted">... e mais ${naoIntegrados - 20} pedidos</p>` : ''}
            </div>
          ` : ''}
          
          ${data.parcialmente_integrados.length > 0 ? `
            <h5 class="mt-4 text-warning">🔄 Pedidos com Fluxo Incompleto</h5>
            <div class="table-responsive">
              <table class="table table-dark table-sm">
                <thead><tr><th>ID Pedido</th><th>Estágio Atual</th><th>Faltando</th></tr></thead>
                <tbody>
                  ${data.parcialmente_integrados.slice(0, 10).map(p => `
                    <tr>
                      <td><code>${p.pedido_id}</code></td>
                      <td>${p.estagio_atual}</td>
                      <td>${p.faltando.join(' → ')}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          ` : ''}
          
          <div class="mt-4">
            <h5>📈 Estatísticas por Marketplace</h5>
            ${Object.entries(data.estatisticas_por_marketplace).map(([mkt, stats]) => `
              <div class="mb-2">
                <strong>${mkt}</strong>: ${stats.integrados}/${stats.total} integrados 
                (${((stats.integrados/stats.total)*100).toFixed(0)}%)
                <div class="progress">
                  <div class="progress-bar bg-success" style="width: ${(stats.integrados/stats.total)*100}%"></div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;
      results.style.display = 'block';
    }
  </script>
</body>
</html>