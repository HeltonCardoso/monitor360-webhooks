<!-- views/pedidos.ejs -->
<div class="row">
  <div class="col-12">
    <h1 class="mb-4">
      <i class="fas fa-boxes"></i> Pedidos
    </h1>
  </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-header">
    <i class="fas fa-filter"></i> Filtros
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-4">
        <label>Buscar Pedido</label>
        <input type="text" class="form-control" id="buscarPedido" placeholder="Número do pedido...">
      </div>
      <div class="col-md-4">
        <label>Status</label>
        <select class="form-control" id="filtroStatus">
          <option value="">Todos</option>
          <option value="PAGO">Pago</option>
          <option value="ENVIADO">Enviado</option>
          <option value="FATURADO">Faturado</option>
        </select>
      </div>
      <div class="col-md-4">
        <label>Apenas Anomalias</label>
        <div class="form-check mt-2">
          <input class="form-check-input" type="checkbox" id="apenasAnomalias">
          <label class="form-check-label" for="apenasAnomalias">
            Mostrar apenas pedidos com problemas
          </label>
        </div>
      </div>
    </div>
    <button class="btn btn-primary mt-3" onclick="carregarPedidos()">
      <i class="fas fa-search"></i> Buscar
    </button>
  </div>
</div>

<!-- Tabela de Pedidos -->
<div class="card">
  <div class="card-header">
    <i class="fas fa-table"></i> Lista de Pedidos
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover" id="tabelaPedidos">
        <thead>
          <tr>
            <th>Pedido</th>
            <th>Cliente</th>
            <th>Marketplace</th>
            <th>AnyMarket</th>
            <th>JET</th>
            <th>Onclick</th>
            <th>Valor</th>
            <th>Atualizado</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="9" class="text-center text-muted">Carregando...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Paginação -->
    <nav aria-label="Paginação">
      <ul class="pagination justify-content-center" id="paginacao">
        <li class="page-item">
          <a class="page-link" href="#" onclick="paginaAnterior(); return false;">Anterior</a>
        </li>
        <li class="page-item active" id="paginaAtual">
          <span class="page-link">1</span>
        </li>
        <li class="page-item">
          <a class="page-link" href="#" onclick="proximaPagina(); return false;">Próxima</a>
        </li>
      </ul>
    </nav>
  </div>
</div>

<script>
  let paginaAtual = 1;

  async function carregarPedidos(pagina = 1) {
    try {
      paginaAtual = pagina;
      const anomaliaOnly = document.getElementById('apenasAnomalias').checked;
      const url = `/api/pedidos?page=${pagina}&limit=20${anomaliaOnly ? '&anomalia=true' : ''}`;

      const response = await fetch(url);
      const data = await response.json();

      const tbody = document.querySelector('#tabelaPedidos tbody');
      tbody.innerHTML = '';

      if (data.pedidos.length === 0) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted">Nenhum pedido encontrado</td></tr>';
        return;
      }

      data.pedidos.forEach(pedido => {
        const statusBadge = (status) => {
          if (!status) return '<span class="status-badge status-desconhecido">-</span>';
          return `<span class="status-badge status-${status.toLowerCase()}">${status}</span>`;
        };

        const anomaliaIcon = pedido.anomalia ? '<i class="fas fa-exclamation-triangle text-danger"></i>' : '';

        const row = `
          <tr>
            <td><strong>${pedido.pedido_id}</strong> ${anomaliaIcon}</td>
            <td>${pedido.cliente_nome || '-'}</td>
            <td>${pedido.marketplace_origem || '-'}</td>
            <td>${statusBadge(pedido.status_anymarket)}</td>
            <td>${statusBadge(pedido.status_jet)}</td>
            <td>${statusBadge(pedido.status_onclick)}</td>
            <td>R$ ${(pedido.valor_total || 0).toFixed(2)}</td>
            <td>${new Date(pedido.atualizado_em).toLocaleString('pt-BR')}</td>
            <td>
              <a href="/pedidos/${pedido.pedido_id}" class="btn btn-sm btn-info">
                <i class="fas fa-eye"></i> Ver
              </a>
            </td>
          </tr>
        `;
        tbody.innerHTML += row;
      });

      document.getElementById('paginaAtual').innerHTML = `<span class="page-link">${pagina}</span>`;

    } catch (error) {
      console.error('Erro ao carregar pedidos:', error);
      showAlert('Erro ao carregar pedidos', 'danger');
    }
  }

  function proximaPagina() {
    carregarPedidos(paginaAtual + 1);
  }

  function paginaAnterior() {
    if (paginaAtual > 1) {
      carregarPedidos(paginaAtual - 1);
    }
  }

  // Inicializar
  carregarPedidos();
</script>