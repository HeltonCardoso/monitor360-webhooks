# Render PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/monitor360

# Webhook Secrets (gera UUIDs aleatórios)
WEBHOOK_SECRET_ANYMARKET=seu-secret-uuid-aqui
WEBHOOK_SECRET_JET=seu-secret-uuid-aqui
WEBHOOK_SECRET_ONLICK=seu-secret-uuid-aqui

# APIs
ANYMARKET_API_KEY=sua-chave-aqui
JET_API_KEY=sua-chave-aqui
ONLICK_API_KEY=sua-chave-aqui

# Alertas
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_EMAIL=seu-email@empresa.com

# JWT
JWT_SECRET=seu-jwt-secret-aleatorio
JWT_EXPIRY=7d

# Ambiente
NODE_ENV=production
PORT=3000